# Copy to .env and fill in. .env is gitignored: never commit real keys.

# RunPod serverless vLLM endpoint (OpenAI-compatible)
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Must match the model the endpoint serves (the worker's MODEL_NAME / OPENAI_SERVED_MODEL_NAME_OVERRIDE)
AI_MODEL=

# Optional
# AI_WORKER_ENABLED=true   # host the AI worker inside the API (default true in docker compose)
# AI_DEBOUNCE_SECONDS=5    # prototype default; conversation quiet time before the AI reads new messages
# AI_POLL_SECONDS=2
# AI_TIMEOUT_SECONDS=180   # covers serverless cold starts
# AI_TOOL_CHOICE=required  # use "auto" if the served vLLM version rejects "required"
# AI_BASE_URL=             # overrides the RunPod URL for any other OpenAI-compatible host
